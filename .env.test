# Test environment — copy this file, fill in DATABASE_URL_TEST, and don't commit secrets.
# Option A: Neon branch  → create a branch in the Neon console, paste the connection string here
# Option B: Local Docker  → docker run -e POSTGRES_PASSWORD=test -p 5433:5432 postgres:16
#            then use: postgresql://postgres:test@localhost:5433/openboat_test

DATABASE_URL_TEST=

# Copy other vars from .env.local that API routes need during integration tests
NEXT_PUBLIC_BASE_URL=http://localhost:3000
SESSION_SECRET=test-session-secret-at-least-32-chars-long
CRON_SECRET=test-cron-secret
